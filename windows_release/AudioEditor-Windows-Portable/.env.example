# Audio Editor Cloud Config - Beispiel
# Kopiere diese Datei zu .env und fülle deine Werte aus
# Oder setze die Variablen direkt in deiner Umgebung

# --- Google Drive Credentials ---
# Option 1: Pfad zu Service Account JSON (empfohlen für Automatisierung)
GOOGLE_APPLICATION_CREDENTIALS=/pfad/zu/service_account.json

# Option 2: JSON Inhalt direkt als Env Variable (für Cloud Deployments)
# GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON={"type": "service_account", "project_id": "...", ...}

# Option 3: Alternative Env Var für Credentials Pfad
# GOOGLE_DRIVE_CREDENTIALS=/pfad/zu/credentials.json

# --- Mock Modus für Entwicklung ohne echte Credentials ---
# Auf 1 setzen um lokale Simulation zu verwenden
USE_MOCK_DRIVE=0

# --- Colab Webhook (optional) ---
# Falls du einen eigenen Webhook Server hast der Colab triggert
# COLAB_WEBHOOK_URL=https://your-webhook.example.com/trigger
# COLAB_WEBHOOK_TOKEN=optional_bearer_token

# --- Polling Konfiguration ---
# POLL_INTERVAL_SECONDS=15
# POLL_TIMEOUT_SECONDS=3600

# --- Drive Ordner (optional override) ---
# DRIVE_BASE_FOLDER=AudioEditor_Stems
