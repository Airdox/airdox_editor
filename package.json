{
  "name": "airdox_SMART_Editor",
  "private": true,
  "version": "0.4.2",
  "description": "airdox_SMART_Editor – Professioneller DJ-Audio-Editor mit nicht-destruktivem Rekordbox-Import.",
  "author": "Airdox",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && npm run build:stems-bridge && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "build:stems-bridge": "esbuild src/stems/nodeBridge.ts --bundle --platform=node --format=cjs --outfile=dist/stems/node-bridge.cjs",
    "start": "node dist/server.cjs",
    "desktop": "npm run build && electron .",
    "package:win": "npm run build && electron-builder --win",
    "package:win:nsis": "npm run build && electron-builder --win nsis",
    "package:win:portable": "npm run build && electron-builder --win portable",
    "preview": "vite preview",
    "stems:setup": "bash scripts/setup-stem-model.sh",
    "stems:setup:bsroformer": "bash scripts/setup-bsroformer-model.sh",
    "stems:diagnose": "tsx scripts/stems-diagnose.ts",
    "stems:gate:archive": "node scripts/build-stem-gate-tarball.mjs",
    "stems:gate:notebook": "node scripts/md-to-notebook.mjs",
    "test:stems": "node scripts/run-tests.mjs --group stems",
    "test:stems:live": "node scripts/run-tests.mjs --group stems-live",
    "test:stems:release": "node scripts/run-tests.mjs --group stems-release --fail-on-skip",
    "test:stems:gate": "node scripts/run-tests.mjs --only stem-isolation-gate-live --fail-on-skip --set-env AIRODOX_STEM_ALLOW_QUALITY_RUN=1",
    "test:stems:gate:strict": "node scripts/run-tests.mjs --only stem-isolation-gate-live --fail-on-skip --set-env AIRODOX_STEM_ALLOW_QUALITY_RUN=1 --set-env AIRODOX_STEM_GATE_FAIL_ON_QUALITY=1",
    "test:stems:all": "node scripts/run-tests.mjs --filter stem-separation- --filter stem-isolation-",
    "stems:setup:win": "powershell -ExecutionPolicy Bypass -File scripts/setup-stem-model.ps1",
    "test:stems:real": "node scripts/run-tests.mjs --filter stem-real-audio --fail-on-skip",
    "test:package": "node -e \"JSON.parse(require('node:fs').readFileSync('package.json','utf8')); console.log('package.json: gültiges JSON')\"",
    "clean": "rm -rf dist release server.js",
    "rebuild:electron": "electron-rebuild -f -w better-sqlite3-multiple-ciphers",
    "lint": "tsc --noEmit",
    "test": "node scripts/run-tests.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "three": "^0.186.0",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/three": "^0.186.0",
    "autoprefixer": "^10.4.21",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  },
  "optionalDependencies": {
    "better-sqlite3-multiple-ciphers": "^12.11.1"
  },
  "build": {
    "appId": "info.airdox.smarteditor",
    "productName": "airdox_SMART_Editor",
    "executableName": "airdox_SMART_Editor",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "src/stems/modelCatalog.json",
      "python/**/*"
    ],
    "extraResources": [
      {
        "from": "resources/stem-runtime",
        "to": "stem-runtime",
        "filter": ["**/*"]
      },
      {
        "from": "resources/models",
        "to": "models",
        "filter": ["**/*"]
      },
      {
        "from": "src/stems/modelCatalog.json",
        "to": "modelCatalog.json"
      }
    ],
    "asar": true,
    "asarUnpack": [
      "**/node-bridge.cjs",
      "**/stem-runtime/**/*",
      "**/models/**/*",
      "**/*.node",
      "**/*.dll",
      "**/*.so",
      "**/*.dylib",
      "python/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "npmRebuild": false,
    "win": {
      "target": ["nsis", "portable"]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "airdox_SMART_Editor"
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.exe"
    },
    "artifactName": "${productName}-${version}-setup.${ext}"
  }
}
