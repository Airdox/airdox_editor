{
  "name": "airdox-smart-editor",
  "private": true,
  "version": "0.4.21",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=esm --packages=external --sourcemap --outfile=dist/server.mjs",
    "start": "node dist/server.mjs",
    "preview": "vite preview",
    "clean": "rm -rf dist release server.js",
    "rebuild:electron": "electron-rebuild -f -w better-sqlite3-multiple-ciphers",
    "lint": "tsc --noEmit",
    "test": "node tests/run-all.mjs",
    "test:all": "node tests/run-all.mjs --only=all",
    "test:ui": "node tests/run-all.mjs --only=vitest",
    "test:script": "node tests/run-all.mjs --only=script",
    "coverage": "node tests/coverage-summary.mjs",
    "coverage:ui": "vitest run --coverage",
    "desktop": "npm run build && electron .",
    "package:win": "npm run build && electron-builder --win",
    "package:win:nsis": "npm run build && electron-builder --win nsis",
    "package:win:portable": "npm run build && electron-builder --win portable"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3",
    "express": "^4.21.2",
    "dotenv": "^17.2.3",
    "motion": "^12.23.24"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@electron/rebuild": "^4.0.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "autoprefixer": "^10.4.21",
    "c8": "^10.1.3",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.0",
    "jsdom": "^25.0.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vitest": "^2.1.9"
  },
  "optionalDependencies": {
    "better-sqlite3-multiple-ciphers": "^12.11.1"
  },
  "build": {
    "appId": "info.airdox.smarteditor",
    "productName": "airdox_SMART_Editor",
    "executableName": "airdox_SMART_Editor",
    "files": [
      "dist/**/*",
      "!dist/**/*.map",
      "electron/**/*",
      "package.json",
      "node_modules/better-sqlite3-multiple-ciphers/**/*"
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3-multiple-ciphers/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "npmRebuild": false,
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "airdox_SMART_Editor"
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.exe"
    },
    "artifactName": "${productName}-${version}-setup.${ext}"
  },
  "description": "airdox_SMART_Editor – professioneller, nicht-destruktiver Rekordbox-Audio-Editor mit Smart Copilot.",
  "author": "Airdox",
  "main": "electron/main.cjs"
}
